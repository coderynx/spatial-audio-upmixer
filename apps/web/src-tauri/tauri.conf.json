{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Upmixer",
  "version": "0.1.0",
  "identifier": "com.coderynx.upmixer",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Upmixer",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ipc:; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "../public/hrir/": "hrir/",
      "../public/xtc/": "xtc/",
      "../public/eq_fir/": "eq_fir/"
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "15.0"
    }
  }
}
